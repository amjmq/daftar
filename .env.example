# Copy to .env (git-ignored). All of this is optional: the same values can be entered in the app's Settings page.

# Language model: any OpenAI-compatible chat API (OpenAI, OpenRouter, Groq, Together, a local Ollama or vLLM ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Speech to text: any OpenAI-compatible /audio/transcriptions API.
# Leave STT_BASE_URL empty to use the same provider (and key) as the language model.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
